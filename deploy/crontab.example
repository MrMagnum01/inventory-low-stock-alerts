# Example cron entry -- runs the low-stock alert report at 07:00 local time
# (after the sales/inventory export jobs are expected to have landed).
# Install with: crontab -e   (as the service account that owns this checkout)
#
# run_daily.sh handles its own locking and retries, so a normal cron
# overlap is safe -- the second invocation skips cleanly instead of racing.
0 7 * * * /opt/inventory-low-stock-alerts/src/run_daily.sh >> /opt/inventory-low-stock-alerts/src/cron.log 2>&1
